{
  "name": "aixpay",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "storybook": "npm run storybook --prefix packages/ui",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android --app-id co.aixpay.debug",
    "android:release": "expo run:android --variant release --app-id co.aixpay",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.js",
    "clean": "npm cache clean --force && node scripts/clean.js",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:metro": "expo start --clear",
    "build:android:apk": "node scripts/build-native.js android",
    "build:android:debug": "node scripts/build-native.js android:debug",
    "build:android:aab": "node scripts/build-native.js android:aab",
    "build:ios": "node scripts/build-native.js ios",
    "i18n:update": "node scripts/crowding-update.js",
    "check:prod": "node scripts/check-production-config.js",
    "check:prod:full": "node scripts/check-production-config.js --typecheck",
    "check:prod:update": "node scripts/check-production-config.js --update --typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "postinstall": "npx patch-package && node -e \"const fs = require('fs'); const path = require('path'); const reactPath = path.join(__dirname, 'packages', 'ui', 'node_modules', 'react'); const reactDomPath = path.join(__dirname, 'packages', 'ui', 'node_modules', 'react-dom'); if (fs.existsSync(reactPath)) { fs.rmSync(reactPath, { recursive: true, force: true }); console.log('✅ 已删除 packages/ui/node_modules/react'); } if (fs.existsSync(reactDomPath)) { fs.rmSync(reactDomPath, { recursive: true, force: true }); console.log('✅ 已删除 packages/ui/node_modules/react-dom'); }\"",
    "gallery:generate": "node scripts/generate-page-gallery-registry.js",
    "gallery:web": "npm run gallery:generate && CI=1 EXPO_NO_TELEMETRY=1 expo start --web --port 19006",
    "gallery:export": "npm run gallery:generate && EXPO_NO_TELEMETRY=1 expo export --platform web --output-dir dist-page-gallery",
    "gallery:capture": "node scripts/capture-page-gallery.js"
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "all",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "co.aixpay.communication"
    },
    "ios": {
      "modulesProvider": {
        "NativeLocalStorage": "RCTNativeLocalStorage",
        "NativeGeneralMethods": "RCTNativeGeneralMethods",
        "NativeBiometricStrategy": "RCTNativeBiometricStrategy",
        "NativeAIXDeviceInfo": "RCTNativeDeviceInfo",
        "NativeAIXFileUploader": "RCTNativeAIXFileUploader"
      },
      "componentProvider": {
        "CustomWebView": "RCTWebView"
      }
    }
  },
  "dependencies": {
    "@aix/icons": "file:vendor/aix-icons-0.1.21.tgz",
    "@aix/pull-to-refresh": "*",
    "@aix/ui": "1.5.8",
    "@crowdin/ota-client": "2.0.2",
    "@expo/vector-icons": "14.1.0",
    "@figma/code-connect": "^1.4.8",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-community/blur": "4.4.1",
    "@react-native-community/checkbox": "0.5.20",
    "@react-native-community/slider": "5.0.1",
    "@react-native-cookies/cookies": "6.2.1",
    "@react-native-firebase/analytics": "23.4.0",
    "@react-native-firebase/app": "23.4.0",
    "@react-native-firebase/crashlytics": "23.4.0",
    "@react-native-firebase/remote-config": "23.4.0",
    "@react-navigation/bottom-tabs": "7.3.10",
    "@react-navigation/elements": "2.3.8",
    "@react-navigation/native": "7.1.6",
    "@shopify/flash-list": "1.7.6",
    "@tamagui/config": "1.143.0",
    "axios": "1.13.2",
    "expo": "~53.0.23",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.7",
    "expo-crypto": "14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.0",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "15.0.8",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-media-library": "~17.1.7",
    "expo-notifications": "~0.31.4",
    "expo-router": "~5.1.7",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-updates": "~0.28.17",
    "expo-video": "~2.2.2",
    "expo-web-browser": "~14.2.0",
    "i18n-js": "4.5.1",
    "jsencrypt": "3.5.4",
    "lottie-react-native": "7.3.5",
    "nativewind": "4.1.23",
    "prettier-plugin-tailwindcss": "0.5.14",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-appsflyer": "6.17.8",
    "react-native-base64": "0.2.1",
    "react-native-device-info": "14.0.4",
    "react-native-expo-moengage": "1.0.1",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-logs": "5.3.0",
    "react-native-mmkv": "3.3.0",
    "react-native-moengage": "12.1.0",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-share": "12.2.6",
    "react-native-video": "6.16.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "socket.io-client": "4.8.3",
    "tailwindcss": "3.4.17",
    "toastify-react-native": "7.2.3",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@changesets/cli": "2.27.9",
    "@react-native-community/cli": "latest",
    "@types/react": "~19.0.10",
    "@types/react-native-base64": "0.2.2",
    "babel-plugin-module-resolver": "5.0.2",
    "esbuild": "0.27.2",
    "eslint": "9.25.0",
    "eslint-config-expo": "~9.2.0",
    "prettier": "3.3.3",
    "react-native-svg": "15.15.1",
    "react-native-svg-transformer": "1.5.1",
    "react-native-worklets": "0.5.1",
    "sharp": "0.34.4",
    "ts-proto": "2.7.5",
    "typescript": "~5.8.3",
    "xml2js": "0.6.2"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.55.1",
    "@swc/core-darwin-arm64": "1.15.11"
  },
  "overrides": {
    "@tamagui/*": "1.143.0",
    "tamagui": "1.143.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-media-library"
        ]
      }
    }
  }
}
