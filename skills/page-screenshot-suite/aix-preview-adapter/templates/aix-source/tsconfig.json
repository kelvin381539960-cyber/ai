{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@specs/*": [
        "./specs/*"
      ],
      "@aix/common": ["./packages/common/src/index.tsx"],
      "@aix/config": ["./packages/config/src/index.ts"],
      "@aix/pull-to-refresh": ["./packages/pull-to-refresh/src/index.ts"],
      "@aix/resources": ["./packages/resources/src/res.tsx"],
      "@aix/ui": ["./packages/ui/src/index.tsx"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/*.figma.tsx",
    "src/preview/excluded-routes/**"
  ]
}
